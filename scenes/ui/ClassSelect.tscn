[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/ClassSelect.cs" id="1_select"]

[node name="ClassSelect" type="CanvasLayer"]
process_mode = 3
layer = 3
script = ExtResource("1_select")

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.03, 0.03, 0.05, 1)

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Layout" type="VBoxContainer" parent="Center"]
